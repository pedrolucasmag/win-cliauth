{
  "name": "win-cliauth",
  "version": "1.0.3",
  "description": "win-cliauth is a CLI-based OTP (One-Time Password) authenticator management tool for Windows.",
  "author": "Pedro Lucas Magalhães <pedrolucasmag@gmail.com>",
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "tsc && node --test \"dist/test/**/*.test.js\"",
    "prepack": "tsc"
  },
  "bin": {
    "win-cliauth": "dist/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrolucasmag/win-cliauth.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "!dist/test"
  ],
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@types/node": "^18.11.10",
    "@types/yargs": "^17.0.10",
    "@typescript-eslint/eslint-plugin": "^5.33.1",
    "@typescript-eslint/parser": "^5.33.1",
    "eslint": "^8.22.0",
    "husky": "^8.0.3",
    "typescript": "^5.4.0"
  },
  "os": [
    "win32"
  ],
  "keywords": [
    "otp",
    "authenticator",
    "cli",
    "windows",
    "steamguard",
    "2fa",
    "totp",
    "steam"
  ],
  "dependencies": {
    "otpauth": "^9.1.4",
    "yargs": "^17.5.1"
  },
  "engines": {
    "node": ">=18"
  }
}
